# Environment variables for hotel-web (Create React App).
#
# 1. Copy this file to `.env` in the same directory (hotel-web/).
# 2. Replace the placeholder values with your own credentials.
# 3. Never commit the real `.env` file — it is gitignored on purpose.
#
# CRA inlines every `REACT_APP_*` variable at build time. Restart the dev
# server after changing any of them.

# Backend origin used by the single API client (src/services/apiClient.js).
# The app refuses to start if this is missing — there is no fallback origin.
REACT_APP_API_URL=http://localhost:4000

# Firebase web configuration.
# Firebase Console > Project Settings > General > Your apps > Web app.
REACT_APP_FIREBASE_API_KEY=your-firebase-api-key
REACT_APP_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
REACT_APP_FIREBASE_PROJECT_ID=your-project-id
REACT_APP_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
REACT_APP_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000

# EmailJS credentials used by the contact form (src/pages/ContactPage.js).
# EmailJS Dashboard > Account > API Keys / Email Services / Templates.
REACT_APP_EMAILJS_SERVICE_ID=your-emailjs-service-id
REACT_APP_EMAILJS_TEMPLATE_ID=your-emailjs-template-id
REACT_APP_EMAILJS_PUBLIC_KEY=your-emailjs-public-key

# Demo account used by the "Entrar como demo" button on the login screen.
# These values are PUBLIC: CRA inlines every REACT_APP_* variable into the
# bundle, so anyone can read the demo password. That is an accepted trade-off
# because the `demo` operator role is READ-ONLY (GET/HEAD only; mutations 403).
# The account must also exist in Firebase Auth with an `operators` row whose
# role is 'demo' (see hotel-backend/migrate_add_demo_role.sql).
REACT_APP_DEMO_EMAIL=your-demo-email@example.com
REACT_APP_DEMO_PASSWORD=your-demo-password
