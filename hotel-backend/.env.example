# Supabase (backend, service role key)
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_SERVICE_KEY=tu-service-role-key

# Port the API listens on
PORT=4000

# Comma-separated list of browser origins allowed to call the API
ALLOWED_ORIGINS=http://localhost:3000

# Auth rollout switch (spec AUTH-5: keep OFF until the rollout is verified).
# 'true' requires a Firebase ID token on /api/admin and /api/operator.
REQUIRE_AUTH=false

# Path to the Firebase Admin service account JSON
FIREBASE_ADMIN_KEY_PATH=./firebase-admin-key.json

# Mercado Pago Checkout Pro (server-side). MP_ACCESS_TOKEN is a SECRET:
# set the real production APP_USR token in the host environment (e.g. Render),
# never in this file and never in git.
MP_ACCESS_TOKEN=

# Public frontend origin, used to build the Mercado Pago back_urls
# (success / failure / pending all return to the payment success page).
FRONTEND_URL=http://localhost:3000

# Public API origin, used to build the Mercado Pago notification_url (webhook).
# Optional: when empty, the request origin is used instead (local development).
BACKEND_URL=

# Instructions:
# 1. Copy this file and rename it to .env
# 2. Replace the placeholder values with your real credentials
# 3. Do NOT commit the .env file to GitHub
